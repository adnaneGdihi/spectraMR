# =============================================================================
# spectraMR environment configuration
# =============================================================================
# Copy to `.env` (gitignored) and edit values for your local / cluster setup.
# `.env` is sourced by SHELL launchers (Makefile targets, container entrypoints,
# and the Slurm submitters in the research tree). Which launchers exist depends
# on your checkout — this distribution ships the framework and its tests, not
# the site-specific job scripts, so run `grep -rl 'source.*\.env' Makefile
# scripts/` to see the consumers you actually have.
#
# Sourcing is a SHELL contract: nothing in the Python package calls load_dotenv().
# A launcher that does not source this file never sees it — a hand-rolled
# `srun ... torchrun` needs `set -a; source "${REPO_ROOT}/.env"; set +a` of its own.
#
# Every variable listed below is read by the framework at some point. The
# defaults are what the code falls back to if the variable is unset. See
# `docs/CLUSTER_DATA_LAYOUT.md` and `src/spectramr/core/env.py` for details.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Path resolution
# -----------------------------------------------------------------------------

# Data root. Every `${SPECTRAMR_DATA_ROOT}/...` placeholder in YAML expands
# against this. Also used by the bootstrap fallback path probe and by the
# config_health_checker's "user-mount exemption" rule.
# Default (if unset): "./databases" relative to CWD.
SPECTRAMR_DATA_ROOT="./databases"

# Project root. Read by PathResolver as the first choice, with SPECTRAMR_DATA_ROOT
# as its fallback (`os.environ.get("PROJECT_ROOT") or
# os.environ.get("SPECTRAMR_DATA_ROOT")`). Set this on HPC if your project lives
# somewhere different from your data root.
# NOTE: PathNormalizer does NOT read this — it reads SPECTRAMR_ROOT below. The two
# are separate variables with separate fallbacks; setting one does not cover the
# other.
# Default (if unset): auto-detected by walking up to find pyproject.toml.
# PROJECT_ROOT="/project/<your-account>/spectramr"

# Repo root used by PathNormalizer (`shared/utils/path_normalizer.py`) to
# resolve relative paths. This is the checkout, not the data — keep it distinct
# from PROJECT_ROOT / SPECTRAMR_DATA_ROOT above.
# Worth setting explicitly on a cluster: the fallback is the *current working
# directory*, so a job whose scheduler dropped it somewhere unexpected resolves
# relative paths against the wrong tree without complaining.
# Default (if unset): os.getcwd().
# SPECTRAMR_ROOT="/project/<your-account>/spectramr"

# Alternate "cluster" mount root (used by `src/spectramr/tools/cluster_explorer.py`).
# Default (if unset): same as PROJECT_ROOT.
# SPECTRAMR_CLUSTER_ROOT="/project/<your-account>/spectramr"

# Optional cache directory (model weights, metric backbones, etc.). Honoured
# by the eval helpers and by upstream libraries (torchvision, timm, lpips, …).
# Default (if unset): resolved by two different helpers whose FALLBACK CHAINS
# DIFFER, so leave it unset only if you do not care which you get —
#   env_resolver.resolve_cache_root() → $TMPDIR/spectramr_cache, else
#                                       ~/.cache/spectramr/torch  (and it stamps
#                                       the answer back into this variable)
#   core.env.cache_root()             → $XDG_CACHE_HOME/spectramr, else
#                                       ~/.cache/spectramr
# Setting it explicitly is what makes the two agree from the start.
# It is also THE control point for the whole cache block in section 7 — those
# eight variables are assigned from this root, so this is the one to move on a
# cluster. On a compute node prefer node-local storage:
# SPECTRAMR_CACHE_ROOT="/tmp/$USER/spectramr_cache"

# Colon-separated list of legacy absolute prefixes to strip from old YAMLs
# before resolving relative to PROJECT_ROOT. Empty disables.
# Default: empty.
# SPECTRAMR_LEGACY_ABS_PREFIXES="/old/cluster/path/:/another/legacy/root/"

# Single legacy cluster prefix auto-rewritten to PROJECT_ROOT by PathNormalizer.
# Default: empty (disabled).
# SPECTRAMR_LEGACY_CLUSTER_PREFIX="/scratch/me/spectramr/"

# FastMRI-specific data root override (some scripts honour this for
# `databases/fastmri/` lookups even when SPECTRAMR_DATA_ROOT is elsewhere).
# Default (if unset): falls back to SPECTRAMR_DATA_ROOT/fastmri.
# FASTMRI_DATASETS_ROOT="/data/fastmri/datasets"

# -----------------------------------------------------------------------------
# 2. Device / determinism / behaviour
# -----------------------------------------------------------------------------

# Silence the import-time clinical-use warning (use in batch jobs only —
# end-users on workstations should keep the warning visible).
# Default: unset → warning fires once on import.
# SPECTRAMR_SUPPRESS_CLINICAL_WARNING=1

# Force CPU-only execution. Useful for CI / smoke runs / non-GPU laptops.
# Default: unset → CUDA used if available.
# FORCE_CPU=1

# Override the auto-detected accelerator device.
# Default: unset → `cuda` if available, else `cpu`.
# SPECTRAMR_DEVICE="cuda:0"

# Compute capability of the machine this run will LAND on, as "<major>.<minor>"
# (e.g. "7.0" for a V100, "8.6" for an A10). Read only when a live probe cannot
# see a device -- `spectramr audit` on a login node -- so the bf16 gate can
# still answer for the compute node. A live probe always wins over it, and a
# malformed value RAISES rather than defaulting to something plausible.
# Default: unset -> the probe answers, or the capability is reported unknown.
# SPECTRAMR_TARGET_COMPUTE_CAPABILITY="8.0"

# Skip the `nvidia-smi` GPU probe in scripts/container/entrypoint.sh
# (useful in CI logs to avoid noise).
# Default: unset → probe runs if nvidia-smi is on PATH.
# SPECTRAMR_NO_GPU_PROBE=1

# Per-process GPU memory cap applied by `initialize_device`. Float in (0, 1].
# Raise it when a node is yours alone and the default cap is the only thing
# standing between you and a larger batch; lower it when sharing a card.
# An unparseable or out-of-range value RAISES at device init rather than being
# ignored (pitfall #9) — a typo must never leave you under a cap you did not
# choose. The resolved value is logged with the GPU line at startup.
# Default (if unset): 0.85.
# SPECTRAMR_GPU_MEMORY_FRACTION=0.85

# Runtime dimension-contract guard. One of: off | observe | enforce.
#   off     — guard not installed.
#   observe — log a warning on a violation, do not raise (rollout default).
#   enforce — raise DimensionContractError at iteration 1.
# An unknown value RAISES (pitfall #15). Prefer `enforce` for a new model's
# first run: it turns a silently-broadcast shape bug into an immediate failure.
# Default (if unset): observe.
# SPECTRAMR_DIMENSION_CONTRACT=observe

# Allow the Gated-Conv+GRU stand-in when the mamba_ssm selective-scan CUDA
# kernel is missing. CPU/CI WIRING TESTS ONLY — the fallback is not an SSM, and
# a run using it is not scientifically "Mamba". Left unset, a missing kernel
# fails loud (pitfall #9/#16), which is the behaviour you want on a real run.
# Install the kernel instead: pip install -e '.[mamba]' --no-build-isolation
# Default: unset → missing kernel raises ImportError.
# SPECTRAMR_ALLOW_MAMBA_FALLBACK=1

# Extra plugin modules to import at startup — dotted module paths, separated by
# the OS path separator (":" on Linux) or by whitespace. Each one is imported so
# its @register_* decorators run, which is how an out-of-tree model/loss/metric
# joins the registries without editing the package.
# A token that fails to import raises PluginImportError and keeps raising on
# retry (deliberate fail-fast) — it is never skipped with a warning.
# Default: unset → no extra plugin modules.
# SPECTRAMR_PLUGINS=my_lab.models:my_lab.losses

# Escalate execution-ledger silent-substitution records from advisory to fatal.
# The ledger always records substitutions; this decides whether a recorded one
# ends the run. Intended for CI lanes, where a substitution should be a failure
# rather than a line in a report.
# Parsed by membership in {1, true, yes} — so "=0" really does mean off here,
# unlike SPECTRAMR_DEBUG / SPECTRAMR_QUIET in section 6. Read the caution there.
# Default: unset → advisory (record, do not raise).
# SPECTRAMR_LEDGER_STRICT=1

# ── Wall-clock chaining ──────────────────────────────────────────────────────
# A cluster job capped at 120h is shorter than a production arm needs, so the
# run stops a margin before its allocation ends, saves, and is requeued. All
# three are set BY THE LAUNCHER (scripts/common/wall_clock.sh and the array
# dispatcher) — setting them by hand here is for debugging only.

# Absolute unix epoch second at which this job's allocation ends. Unset means
# "no wall": train to max_iterations. A non-numeric value raises.
# Default: unset → derived from Slurm, or absent.
# SPECTRAMR_WALL_CLOCK_DEADLINE=

# Seconds reserved before that deadline for the final checkpoint write. The
# deadline is inspected every min(logging.intervals.log, 100) steps, so this
# must cover that many steps plus the write.
# Default: 900.
# SPECTRAMR_WALL_CLOCK_MARGIN_S=900

# Absolute path the run writes when it yields at the wall. The LAUNCHER names
# it and the run obeys, so the side that reads it back cannot look somewhere
# the side that wrote it never went.
# Default: unset → <training.output_dir>/WALL_CLOCK_YIELD.
# SPECTRAMR_WALL_CLOCK_MARKER=

# Python hash seed for determinism. Required for reproducible runs that
# touch dict-iteration order in registries / loss-composition.
# Default: unset → Python uses random seed.
PYTHONHASHSEED=42

# CUBLAS workspace config. Required for deterministic CUDA matmuls under
# PyTorch >= 2.x. `src/spectramr/pipelines/train.py` sets this with
# `os.environ.setdefault` BEFORE importing torch.
# Default: ":4096:8" (set by the training pipeline).
# CUBLAS_WORKSPACE_CONFIG=":4096:8"

# -----------------------------------------------------------------------------
# 3. CUDA / PyTorch tuning
# -----------------------------------------------------------------------------

# Restrict visible GPUs. Comma-separated indices.
# Default: unset → all GPUs visible.
# CUDA_VISIBLE_DEVICES=0,1

# PyTorch CUDA allocator config — `expandable_segments:True` reduces
# fragmentation for diffusion / large-batch training. Set this BEFORE Python
# imports torch.
# Default: unset → PyTorch default allocator.
# PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

# Tighter CUDA JIT-compile cache to amortise startup. Optional.
# Default: unset → PyTorch default (~64MB).
# CUDA_CACHE_MAXSIZE="2147483648"  # 2 GB
# CUDA_CACHE_CONFIG=2

# PyTorch model-cache directory. Honoured by torch.hub / timm / torchvision.
# Default: unset → ~/.cache/torch.
# TORCH_HOME="$HOME/.cache/torch"

# Keeps the eager-mode CUDA cache manager active. Set to "1" by main.py.
# Default: set to 1 at import; export only to override.
# TORCH_CUDA_EAGER_CACHE_MANAGER=1

# -----------------------------------------------------------------------------
# 4. Threading (set these to 1 for single-GPU runs; >1 hurts torch perf)
# -----------------------------------------------------------------------------

OMP_NUM_THREADS=8
MKL_NUM_THREADS=8
OPENBLAS_NUM_THREADS=8

# -----------------------------------------------------------------------------
# 5. Distributed training (torchrun / FSDP / multi-container)
# -----------------------------------------------------------------------------

# These are populated automatically by `torchrun` /
# `scripts/container/launch_multi_container.sh`. Listed here for reference;
# do NOT set them manually unless you are launching by hand.
# RANK=0
# LOCAL_RANK=0
# WORLD_SIZE=1
# LOCAL_WORLD_SIZE=1
# MASTER_ADDR=localhost
# MASTER_PORT=29500

# SPECTRAMR_LAUNCH_* (BACKEND, ACCOUNT, GPUS, ...) — same deal, one level up:
# `spectramr launch` exports them and the child run reads them back to stamp how
# it was launched into provenance. NEVER set one by hand; you would not be
# configuring the launch, you would be falsifying the record of it. The exact
# member list is derived from _LAUNCH_RESOURCE_FIELDS in
# src/spectramr/infrastructure/execution/backends.py — deliberately not copied
# here, and deliberately not registered in core/env.py.

# -----------------------------------------------------------------------------
# 6. CLI / terminal rendering
# -----------------------------------------------------------------------------

# Force colored CLI output even when piped (the audit CLI honours this).
# FORCE_COLOR=1

# Suppress colored output entirely.
# NO_COLOR=1

# Print full tracebacks on error — the environment twin of `-v` / `--verbose`.
# CAUTION: read for bare truthiness (`os.environ.get("SPECTRAMR_DEBUG")`), NOT as
# a boolean, so SPECTRAMR_DEBUG=0 ENABLES it. `unset SPECTRAMR_DEBUG` is the only
# way to turn it off.
# Default: unset → concise error + exit 1.
# SPECTRAMR_DEBUG=1

# Suppress the CLI startup notice (also suppressed by
# SPECTRAMR_SUPPRESS_CLINICAL_WARNING). Worth setting in batch jobs, where the
# notice is printed once per rank into the same log.
# CAUTION: same bare-truthiness read as SPECTRAMR_DEBUG — SPECTRAMR_QUIET=0 is
# quiet. Unset it to turn it off.
# Default: unset → notice printed.
# SPECTRAMR_QUIET=1

# -----------------------------------------------------------------------------
# 7. Filesystem
# -----------------------------------------------------------------------------

# ONLY TWO OF THE VARIABLES IN THIS SECTION ARE YOURS TO SET.
# `configure_cache_environment` (infrastructure/config/env_resolver.py) hangs the
# whole cache block off one root and ASSIGNS each member, so exporting TMPDIR,
# TORCH_HOME, TORCH_METRICS_CACHE, XDG_CACHE_HOME, CUDA_CACHE_CONFIG,
# CUDA_CACHE_PATH or TORCHINDUCTOR_CACHE_DIR yourself
# is overwritten and has no effect. That is deliberate: a site profile exporting
# XDG_CACHE_HOME="$HOME/.cache" would otherwise keep torch's JIT extension build
# root inside $HOME, which is the failure the block exists to prevent.
#   • SPECTRAMR_CACHE_ROOT  — moves all eight (see section 1).
#   • TRITON_CACHE_DIR    — moves Triton alone; the one setdefault.
# Examples below use /tmp/$USER: node-local (Triton's cache must stay off NFS or
# DeepSpeed hangs at rank exit) and per-user (/tmp is sticky and shared, so a
# bare /tmp/<name> belongs to whoever created it first).

# Temporary file directory (used by training-time checkpoint flush + transforms).
# Default: /tmp. OVERWRITTEN from the cache root — set SPECTRAMR_CACHE_ROOT instead.
# TMPDIR="/tmp/$USER/tmp"

# XDG cache root — honoured by SPECTRAMR_CACHE_ROOT's auto-default.
# Default: ~/.cache. OVERWRITTEN from the cache root.
# XDG_CACHE_HOME="$HOME/.cache"

# torchmetrics' cache. Pointed at <cache_root>/torchmetrics_cache by main.py.
# Default: set at import from SPECTRAMR_CACHE_ROOT. OVERWRITTEN from the cache root.
# TORCH_METRICS_CACHE="/tmp/$USER/spectramr_cache/torchmetrics_cache"

# Inductor's artifact cache — the generated Python modules and compiled kernels
# torch.compile produces. Default: tempfile.gettempdir()/torchinductor_$USER.
# ASSIGNED to <cache_root>/inductor_cache, and assigned rather than inherited on
# purpose: gettempdir() memoizes, so an early call freezes it at /tmp and the
# TMPDIR redirect silently stops applying while the env var still looks right.
# OVERWRITTEN from the cache root — set SPECTRAMR_CACHE_ROOT instead.
# TORCHINDUCTOR_CACHE_DIR="/tmp/$USER/spectramr_cache/inductor_cache"

# PTX JIT cache directory — the spelling the NVIDIA driver actually reads.
# Default: ~/.nv/ComputeCache. OVERWRITTEN from the cache root.
# (CUDA_CACHE_CONFIG in section 4 is NOT one of the driver's three variables;
# see issue #2178. Documented there as =2, a flag, while the cache layout
# assigns it a directory — one of the two is wrong.)
# CUDA_CACHE_PATH="/tmp/$USER/spectramr_cache/cuda_cache"

# Triton's cache root — the ONE cache directory that does not follow
# XDG_CACHE_HOME. Triton defaults to ~/.triton, and DeepSpeed populates it
# during `import deepspeed`, so on a cluster home with a quota the import dies
# with `OSError: [Errno 28] No space left on device` before any spectraMR code
# runs. main.py setdefault()s it under SPECTRAMR_CACHE_ROOT; set it explicitly to
# override (DeepSpeed also recommends a non-NFS path to avoid exit hangs).
# NOTE: a bare `python -c "import deepspeed"` never loads main.py, so export
# this yourself when verifying the extra by hand.
# BECAUSE it is setdefault'd, an unusable value you inherit from a site profile
# or launcher SURVIVES and the run dies creating it — `Permission denied:
# '/triton_cache'` is what an unset ${PREFIX} in "${PREFIX}/triton_cache" looks
# like. `unset TRITON_CACHE_DIR` hands it back to the framework.
# TRITON_CACHE_DIR="/tmp/$USER/triton_cache"

# -----------------------------------------------------------------------------
# 8. sim2rank evaluation tooling
# -----------------------------------------------------------------------------
# The SIM2RANK_* knobs are consumed by `scripts/sim2rank/`, which is part of the
# internal research tree and is NOT included in this distribution. They are
# omitted here rather than listed: advertising a knob whose only reader is
# absent is precisely the inert-knob over-claim this file exists to avoid
# (CLAUDE.md pitfall #15). If you vendor that tooling, its orchestrator header
# documents the full set.

# -----------------------------------------------------------------------------
# 9. Scheduler / container identity (site-specific — change these to move host)
# -----------------------------------------------------------------------------
# Read by the execution backends (`infrastructure/execution/backends.py`).
# `ResourceSpec` is the ONE owner of these values and carries NO built-in
# default (#1146), so on a new cluster setting them here is all that is
# required — nothing inside the package has to be edited.
#
# One caveat remains. `#SBATCH` directives in a hand-written `*.sbatch` are
# parsed by Slurm, not by the shell, so NO variable — from this file or from
# anywhere else — ever reaches them (#1145). Override those at submit time:
# `sbatch --account=...`; submit-time flags outrank directives.

# Slurm --account. Rejected at submit time if it is not an allocation you
# belong to, so this is usually the first thing to change on a new cluster.
# Default (if unset): the `--account` directive is OMITTED entirely and the
# cluster applies your own default allocation. That is deliberate — rendering
# a placeholder would submit a job Slurm rejects outright (#1146).
# SPECTRAMR_SLURM_ACCOUNT="<your-allocation>"

# Slurm --partition / queue name.
# Default (if unset): the flag is OMITTED entirely and the cluster's own default
# partition applies — which is usually right, so leave it unset unless you need
# a specific queue.
# SPECTRAMR_SLURM_PARTITION="gpu"

# Slurm --mail-user for campaign-generated job scripts.
# Default (if unset): the `#SBATCH --mail-user` line is OMITTED entirely and
# Slurm applies its own policy -- the correct behaviour for anyone who is not
# this site's original author.
# SPECTRAMR_SLURM_MAIL_USER="you@example.edu"

# Docker image tag for the container execution backend.
# Default (if unset): "spectramr:v6.1".
# SPECTRAMR_DOCKER_IMAGE="spectramr:v6.1"

# Apptainer/Singularity .sif image for the container execution backend.
# Relative names resolve against the working directory, so prefer an absolute
# path on a cluster where jobs start somewhere you did not choose.
# Default (if unset): "spectramr.sif".
# SPECTRAMR_APPTAINER_SIF="/project/<your-account>/images/spectramr.sif"
